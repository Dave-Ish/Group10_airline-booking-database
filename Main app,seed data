"""main.py: entry point. Sets up the database, handles login/register,
then routes the user to the right menu by role.

Teammate modules expected (agree these signatures in the team meeting):
    auth.py     register_user(username, password) -> user_id
                login_user(username, password)    -> dict {id, username, role, language} or None
    student.py  student_menu(user, conn)
    admin.py    admin_menu(user, conn)
Until a module exists, a small stand-in below is used so main.py still runs.
"""
import hashlib
import os
import sqlite3

BASE_DIR = os.path.dirname(os.path.abspath(__file__))
DB_PATH = os.path.join(BASE_DIR, "db", "app.db")


def get_connection():
    conn = sqlite3.connect(DB_PATH)
    conn.row_factory = sqlite3.Row
    return conn


def init_db(conn):
    """Create tables, then load seed questions only if the table is empty."""
    for name in ("schema.sql", "seed.sql"):
        if name == "seed.sql":
            if conn.execute("SELECT COUNT(*) FROM questions").fetchone()[0] > 0:
                continue
        with open(os.path.join(BASE_DIR, "db", name), encoding="utf-8") as f:
            conn.executescript(f.read())
    conn.commit()


# --- Imports from teammates, with stand-ins so main.py runs on its own -------
try:
    from auth import register_user, login_user
except ImportError:
    def register_user(username, password, role="student"):
        conn = get_connection()
        try:
            h = hashlib.sha256(password.encode()).hexdigest()
            cur = conn.execute(
                "INSERT INTO users (username, password_hash, role) VALUES (?, ?, ?)",
                (username, h, role))
            conn.commit()
            return cur.lastrowid
        except sqlite3.IntegrityError:
            return None
        finally:
            conn.close()

    def login_user(username, password):
        conn = get_connection()
        h = hashlib.sha256(password.encode()).hexdigest()
        row = conn.execute(
            "SELECT id, username, role, language FROM users "
            "WHERE username = ? AND password_hash = ?", (username, h)).fetchone()
        conn.close()
        return dict(row) if row else None

try:
    from student import student_menu
except ImportError:
    def student_menu(user, conn):
        print(f"[student menu not yet connected] Hello {user['username']}")

try:
    from admin import admin_menu
except ImportError:
    def admin_menu(user, conn):
        print(f"[admin menu not yet connected] Hello {user['username']}")

MENUS = {"student": student_menu, "admin": admin_menu}


def route_by_role(user, conn):
    menu = MENUS.get(user["role"])
    if menu is None:
        print(f"No menu for role '{user['role']}'.")
        return
    menu(user, conn)


def do_register():
    username = input("Choose a username: ").strip()
    password = input("Choose a password: ").strip()
    if not username or not password:
        print("Username and password cannot be empty.")
        return
    user_id = register_user(username, password)
    if user_id:
        print("Account created. You can now log in.")
    else:
        print("That username is already taken.")


def do_login(conn):
    username = input("Username: ").strip()
    password = input("Password: ").strip()
    user = login_user(username, password)
    if user is None:
        print("Wrong username or password.")
        return
    print(f"Welcome, {user['username']}!")
    route_by_role(user, conn)


def main():
    conn = get_connection()
    init_db(conn)
    while True:
        print("\n=== Main Menu ===")
        print("1. Log in")
        print("2. Register")
        print("0. Exit")
        choice = input("Choose an option: ").strip()
        if choice == "1":
            do_login(conn)
        elif choice == "2":
            do_register()
        elif choice == "0":
            print("Goodbye!")
            break
        else:
            print("Invalid option, try again.")
    conn.close()


if __name__ == "__main__":
    main()
    # Multilingual Quiz App

A command-line app where users register, log in, and are sent to the menu for their role (student or admin). Questions are available in Kinyarwanda (`rw`), Swahili (`sw`), French (`fr`) and English (`en`).

## How to run

Requires Python 3.8+ (no extra packages; uses the built-in `sqlite3`).

```bash
git clone <repo-url>
cd <repo-folder>
python main.py
